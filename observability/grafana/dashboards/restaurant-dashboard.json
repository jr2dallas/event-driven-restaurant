      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
      "id": 41,
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "title": "Kafka Records Consumed / s",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(kafka_consumer_fetch_manager_records_consumed_total{job=\"restaurant-service\"}[1m])) by (topic)",
          "legendFormat": "{{topic}}"
        }
      ]
    }

