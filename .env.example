# ── Logging ──────────────────────────────────────────────────────────────────
# Log level for all Spring Boot services (DEBUG, INFO, WARN, ERROR)
SPRING_LOG_LEVEL=WARN

# Log level for Consul agent
CONSUL_LOG_LEVEL=warn

# ── Kitchen scaling ───────────────────────────────────────────────────────────
# Absolute or relative path to the directory containing docker-compose.yml
# Only required when running restaurant-service outside Docker (local dev)
KITCHEN_SCALING_COMPOSE_DIR=./

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
